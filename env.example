# VPN settings — copy to .env and fill in the real values:
#   cp env.example .env
# The .env file is NOT versioned (.gitignore). Environment variables already
# exported in the shell take precedence over the .env file.

# --- Corporate VPN (Fortinet SSL VPN / openfortivpn) ---
VPN_CORP_GATEWAY=vpn.example.com
VPN_CORP_PORT=443
# Local port used by the SAML/SSO flow (browser redirect)
VPN_CORP_SAML_PORT=8020

# --- Lab VPN (OpenVPN) ---
# Path of the .ovpn profile installed by install.sh
VPN_LAB_PROFILE=/etc/openvpn/client/lab.ovpn
# Lab VPN username (avoids typing it on every connection; never the password!)
#VPN_USER=my_username
